# ---- Core ----
NODE_ENV=development
API_PORT=8080
LOG_LEVEL=info

# ---- Database (Postgres) ----
DATABASE_URL=postgresql://aispeak:aispeak@localhost:5432/aispeak

# ---- Redis (rate limiting + job queue). Leave blank to run fully in-process. ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# 32+ byte secrets. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-000000000000
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-11111111111
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# ---- AI providers ----
# provider selection: "mock" runs offline & deterministic; "openai" calls a real endpoint.
LLM_PROVIDER=mock
TTS_PROVIDER=mock
STT_PROVIDER=mock
PRONUNCIATION_PROVIDER=mock

# Used only when *_PROVIDER=openai / azure etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Business rules ----
FREE_DAILY_MINUTES=15
